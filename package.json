{
  "name": "gomimon-tests",
  "version": "0.2.0",
  "description": "Test suite for GomiMon extension",
  "scripts": {
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "node tests/e2e/run-e2e-tests.js"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.254",
    "@types/jest": "^29.5.0",
    "jest": "^29.5.0",
    "jest-chrome": "^0.8.0",
    "jest-environment-jsdom": "^29.5.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": ["<rootDir>/tests/setup.js"],
    "collectCoverageFrom": [
      "*.js",
      "!*.config.js",
      "!tests/**",
      "!node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
