{
  "manifest_version": 3,
  "name": "GomiMon",
  "version": "0.4.1",
  "description": "A virtual pet that eats AI slop from your feed.",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "contextMenus",
    "scripting",
    "notifications",
    "offscreen",
    "identity"
  ],
  "host_permissions": [
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.facebook.com/*",
    "*://*.reddit.com/*",
    "*://reddit.com/*",
    "https://gomimon-api.goldentechlabs.com/*",
    "http://localhost:8090/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.reddit.com/*",
        "*://reddit.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ],
      "js": [
        "platforms.js",
        "detector/revision.js",
        "reddit-detector.js",
        "x-detector.js",
        "detector/store.js",
        "detector/policy.js",
        "detector/scheduler.js",
        "detector/renderer.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sprites/*.svg",
        "sprites/animated/*.gif",
        "sounds/*.wav",
        "constants.js",
        "platforms.js",
        "minigames/scholar/*.html",
        "minigames/scholar/*.css",
        "minigames/scholar/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "assets/feed-bowl.png",
        "assets/feeding/fine-dining-table.png",
        "assets/feeding/toaster.png",
        "assets/feeding/popcorn.png"
      ],
      "matches": [
        "*://*.reddit.com/*",
        "*://reddit.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
