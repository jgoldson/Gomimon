gomimon-api.goldentechlabs.com {
    encode zstd gzip
    handle /privacy.html {
        root * /srv/gomimon/public
        file_server
    }
    handle {
        reverse_proxy 127.0.0.1:8090
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }
}
