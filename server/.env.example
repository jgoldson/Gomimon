NODE_ENV=development
PORT=8090
BASE_URL=https://gomimon-api.goldentechlabs.com
DATABASE_URL=postgresql://gomimon:change-me@127.0.0.1:5432/gomimon
TYPESAFE_API_KEY=replace-me
SESSION_SIGNING_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_CALLBACK_URL=https://gomimon-api.goldentechlabs.com/auth/google/callback
CHROME_EXTENSION_REDIRECT_PREFIXES=https://replace-extension-id.chromiumapp.org/
DAILY_CHECK_LIMIT=1000
SERVER_DAILY_CHECK_LIMIT=100000
ACCOUNT_THROTTLE_WINDOW_MS=60000
ACCOUNT_THROTTLE_PER_WINDOW=30
ALLOWED_ORIGINS=*

# Stripe sandbox only. Enabling this with NODE_ENV=production is rejected.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PLUS_PRICE_ID=price_replace_me
STRIPE_PORTAL_CONFIGURATION_ID=bpc_replace_me
